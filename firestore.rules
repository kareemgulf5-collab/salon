rules_version = '2';
// =====================================================================
//  قواعد الأمان — مصطفي عاشور
//  الصقها في: Firebase Console ← Firestore Database ← Rules ← Publish
//  ⚠️ انشرها بعد ما تعمل حساب المالك وترحّل البيانات من الموقع الجديد
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function isStaff() {
      return signedIn() && exists(staffPath()) && get(staffPath()).data.active == true;
    }
    function isOwner() { return isStaff() && get(staffPath()).data.role == 'owner'; }
    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }

    // ---------- أول تشغيل: إنشاء حساب المالك مرة واحدة بس ----------
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn() && !setupDone()
        && getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'owner';
      allow update, delete: if false;
    }

    // ---------- المستخدمين ----------
    match /staff/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      // المالك الأول (أثناء الإعداد) أو مالك موجود بيضيف موظف
      allow create: if isOwner()
        || (signedIn() && request.auth.uid == uid && !setupDone()
            && existsAfter(/databases/$(database)/documents/meta/setup)
            && request.resource.data.role == 'owner' && request.resource.data.active == true);
      allow update: if isOwner();
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // ---------- عدّاد أرقام الفواتير + حالة الترحيل ----------
    match /meta/counters { allow read, write: if isStaff(); }
    match /meta/{doc} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /settings/{doc} { allow read: if isStaff(); allow write: if isOwner(); }

    // ---------- بيانات الشغل ----------
    match /customers/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isOwner();
    }
    match /services/{id} { allow read: if isStaff(); allow write: if isOwner(); }
    match /barbers/{id}  { allow read: if isStaff(); allow write: if isOwner(); }

    match /invoices/{id} {
      allow read: if isStaff();
      allow create: if isOwner()
        || (isStaff()
            && request.resource.data.total is number && request.resource.data.total >= 0
            && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isOwner();   // الكاشير مينفعش يعدّل أو يمسح فاتورة
    }
    match /appointments/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isOwner();
    }
    match /barberTx/{id} { allow read, write: if isOwner(); }
    match /expenses/{id} { allow read, write: if isOwner(); }

    // ---------- النظام القديم (نسخة احتياطية — للقراءة بس) ----------
    match /salon/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
